generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum CardAccountStatus {
  ACTIVE
  DELINQUENT
  CLOSING
  CLOSED
}

enum MovementType {
  PURCHASE
  REVERSAL
  PAYMENT
  INTEREST
  LATE_FEE
  COLLATERAL_APPLICATION
  INSTALLMENT_PRINCIPAL
  INSTALLMENT_INTEREST
}

enum Bucket {
  PRINCIPAL
  DEFERRED
  INTEREST
  FEES
}

enum Direction {
  DEBIT
  CREDIT
}

model CardAccount {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId           String            @map("owner_id")
  custodyAccountId  String            @unique @map("custody_account_id") @db.Uuid
  currency          String            @default("USD")
  status            CardAccountStatus @default(ACTIVE)
  principal         BigInt            @default(0)
  deferred          BigInt            @default(0)
  interest          BigInt            @default(0)
  fees              BigInt            @default(0)
  limitCap          BigInt?           @map("limit_cap")
  limitCapSettledAt DateTime?         @map("limit_cap_settled_at") @db.Timestamptz()
  cycleDay          Int               @map("cycle_day")
  termsVersion      Int               @map("terms_version")
  closureKey        String?           @map("closure_key")
  closureReason     String?           @map("closure_reason")
  closureDebt       BigInt?           @map("closure_debt")
  closedAt          DateTime?         @map("closed_at") @db.Timestamptz()
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz()
  movements         Movement[]
  profile           BillingProfile?
  statements        Statement[]
  plans             InstallmentPlan[]

  @@index([ownerId])
  @@index([status])
  @@map("card_accounts")
}

model Movement {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId           String           @map("account_id") @db.Uuid
  type                MovementType
  bucket              Bucket
  direction           Direction
  amount              BigInt
  bucketBalanceAfter  BigInt           @map("bucket_balance_after")
  referenceMovementId String?          @map("reference_movement_id") @db.Uuid
  statementId         String?          @map("statement_id") @db.Uuid
  note                String?
  installments        Int?
  rateBps             Int?             @map("rate_bps")
  effectiveAt         DateTime         @default(now()) @map("effective_at") @db.Timestamptz()
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  account             CardAccount      @relation(fields: [accountId], references: [id])
  plan                InstallmentPlan?

  @@index([accountId, effectiveAt])
  @@index([referenceMovementId])
  @@map("movements")
}

model IdempotencyKey {
  scope       String
  ownerId     String   @map("owner_id")
  key         String
  requestHash String   @map("request_hash")
  statusCode  Int?     @map("status_code")
  response    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@id([scope, ownerId, key])
  @@map("idempotency_keys")
}

model AuditLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId       String   @map("actor_id")
  actorType     String   @map("actor_type")
  action        String
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  correlationId String?  @map("correlation_id")
  data          Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([entityType, entityId])
  @@map("audit_log")
}

model BillingProfile {
  accountId       String      @id @map("account_id") @db.Uuid
  nextCutDate     DateTime    @map("next_cut_date") @db.Date
  lastCutDate     DateTime?   @map("last_cut_date") @db.Date
  cycleNumber     Int         @default(0) @map("cycle_number")
  delinquentSince DateTime?   @map("delinquent_since") @db.Date
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz()
  account         CardAccount @relation(fields: [accountId], references: [id])

  @@index([nextCutDate])
  @@map("billing_profiles")
}

model Statement {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId            String            @map("account_id") @db.Uuid
  cycleNumber          Int               @map("cycle_number")
  periodStart          DateTime          @map("period_start") @db.Date
  periodEnd            DateTime          @map("period_end") @db.Date
  dueDate              DateTime          @map("due_date") @db.Date
  openingBalance       BigInt            @map("opening_balance")
  purchases            BigInt
  reversals            BigInt
  payments             BigInt
  interestCharged      BigInt            @map("interest_charged")
  feesCharged          BigInt            @map("fees_charged")
  installmentPrincipal BigInt            @default(0) @map("installment_principal")
  installmentInterest  BigInt            @default(0) @map("installment_interest")
  deferredPurchases    BigInt            @default(0) @map("deferred_purchases")
  deferredBalance      BigInt            @default(0) @map("deferred_balance")
  installmentDetails   Json              @default("[]") @map("installment_details")
  closingBalance       BigInt            @map("closing_balance")
  minimumPayment       BigInt            @map("minimum_payment")
  termsVersion         Int               @map("terms_version")
  termsSnapshot        Json              @map("terms_snapshot")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz()
  account              CardAccount       @relation(fields: [accountId], references: [id])
  outcome              StatementOutcome?

  @@unique([accountId, cycleNumber])
  @@index([dueDate])
  @@map("statements")
}

model StatementOutcome {
  statementId String    @id @map("statement_id") @db.Uuid
  outcome     String
  decidedAt   DateTime  @default(now()) @map("decided_at") @db.Timestamptz()
  statement   Statement @relation(fields: [statementId], references: [id])

  @@map("statement_outcomes")
}

model InstallmentPlan {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId          String      @map("account_id") @db.Uuid
  purchaseMovementId String      @unique @map("purchase_movement_id") @db.Uuid
  principal          BigInt
  installments       Int
  aprBps             Int         @map("apr_bps")
  installmentAmount  BigInt      @map("installment_amount")
  remainingPrincipal BigInt      @map("remaining_principal")
  billedCount        Int         @default(0) @map("billed_count")
  status             String      @default("ACTIVE")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz()
  account            CardAccount @relation(fields: [accountId], references: [id])
  purchase           Movement    @relation(fields: [purchaseMovementId], references: [id])

  @@index([accountId, status])
  @@map("installment_plans")
}
