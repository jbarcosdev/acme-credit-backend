{
  "name": "acme-credit",
  "version": "0.0.1",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"{services,lib}/**/{src,test}/**/*.ts\"",
    "test": "pnpm -r test",
    "test:e2e": "pnpm -r test:e2e",
    "check": "pnpm build && pnpm lint && pnpm test && pnpm test:e2e",
    "dev:lending": "pnpm --filter @acme/lending start:dev",
    "dev:collateral": "pnpm --filter @acme/collateral start:dev",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "prettier": "^3.4.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
